{
	"openapi": "3.0.2",
	"info": {
		"title": "mia-users-management",
		"version": "1.0.0",
		"description": "Plugin de gestion des utilisateurs de MIA."
	},
	"paths": {
		"/mia-users-management/public/index.html": {
			"get": {
				"description": "",
				"summary": "Plugin's front",
				"operationId": "getFrontIndex",
				"responses": {
					"200": {
						"description": "Plugin's front",
						"content": {
							"text/html": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-users-management/public/bundle.min.js": {
			"get": {
				"description": "",
				"summary": "Plugin's front app",
				"operationId": "getFrontApp",
				"responses": {
					"200": {
						"description": "Plugin's front app",
						"content": {
							"application/javascript": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-users-management/public/bundle.min.js.map": {
			"get": {
				"description": "",
				"summary": "Plugin's front app map",
				"operationId": "getFrontAppMap",
				"responses": {
					"200": {
						"description": "Plugin's front app",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": true
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-users-management/api/descriptor": {
			"get": {
				"description": "",
				"summary": "Plugin's descriptor",
				"operationId": "getPluginDescriptor",
				"security": [
					{
						"bearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "Plugin's descriptor",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-users-management/api/status": {
			"get": {
				"description": "",
				"summary": "Plugin's status",
				"operationId": "getPluginStatus",
				"security": [
					{
						"bearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "Plugin's status",
						"content": {
							"application/json": {
								"schema": {
									"type": "string",
									"enum": [
										"ENABLED",
										"INITIALIZED",
										"RELEASED"
									]
								}
							}
						}
					},
					"404": {
						"description": "The plugin is not enabled (=RELEASED)",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-users-management/api/users": {
			"get": {
				"description": "List all users. Available to any authenticated caller; sensitive actions remain gated on write/token routes.",
				"summary": "List users",
				"operationId": "getUsers",
				"security": [
					{
						"bearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "Users list",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/User"
									}
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"put": {
				"description": "Create a user. Admin only. Username is set at creation and cannot be changed later.",
				"summary": "Create user",
				"operationId": "createUser",
				"security": [
					{
						"bearerAuth": []
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"description": "Payload to create a user",
								"properties": {
									"name": {
										"type": "string",
										"minLength": 1
									},
									"password": {
										"type": "string",
										"minLength": 1
									},
									"isAdmin": {
										"type": "boolean",
										"default": false
									}
								},
								"required": [
									"name",
									"password"
								]
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "User created",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/User"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-users-management/api/users/{name}": {
			"parameters": [
				{
					"name": "name",
					"in": "path",
					"required": true,
					"schema": {
						"type": "string",
						"minLength": 1
					},
					"description": "Username (immutable identifier)"
				}
			],
			"get": {
				"description": "Get a user by name.",
				"summary": "Get user",
				"operationId": "getUser",
				"security": [
					{
						"bearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "User",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/User"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"post": {
				"description": "Update a user (password and/or isAdmin). Username cannot be modified. Allowed for admin, or for the user themselves (self may update own password; isAdmin typically admin-only at Mediator).",
				"summary": "Update user",
				"operationId": "updateUser",
				"security": [
					{
						"bearerAuth": []
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"description": "Payload to update a user. Name cannot be changed (use path param only as identifier).",
								"properties": {
									"password": {
										"type": "string",
										"minLength": 1
									},
									"isAdmin": {
										"type": "boolean"
									}
								},
								"additionalProperties": false,
								"minProperties": 1
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "User updated",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/User"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"delete": {
				"description": "Delete a user. Admin only, or the user deleting themselves when allowed by product rules.",
				"summary": "Delete user",
				"operationId": "deleteUser",
				"security": [
					{
						"bearerAuth": []
					}
				],
				"responses": {
					"204": {
						"description": "User deleted"
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-users-management/api/users/{name}/tokens": {
			"parameters": [
				{
					"name": "name",
					"in": "path",
					"required": true,
					"schema": {
						"type": "string",
						"minLength": 1
					},
					"description": "Username whose tokens are listed"
				}
			],
			"get": {
				"description": "List tokens for a user. Allowed only for the user themselves, or for an admin. Tokens cannot be created or modified through this plugin.",
				"summary": "List user tokens",
				"operationId": "getUserTokens",
				"security": [
					{
						"bearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "Tokens list",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"type": "object",
										"description": "Public token representation",
										"properties": {
											"token": {
												"type": "string",
												"minLength": 1
											},
											"fingerprint": {
												"type": "string"
											},
											"createdAt": {
												"type": "string",
												"format": "date-time"
											}
										},
										"required": [
											"token",
											"fingerprint",
											"createdAt"
										]
									}
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-users-management/api/tokens": {
			"delete": {
				"description": "Delete a token. The token value MUST be passed in the request body (never in path or query). Allowed for the token owner or an admin. Tokens cannot be modified.",
				"summary": "Delete token",
				"operationId": "deleteToken",
				"security": [
					{
						"bearerAuth": []
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"description": "Payload to delete a token (token value in body only)",
								"properties": {
									"token": {
										"type": "string",
										"minLength": 1
									}
								},
								"required": [
									"token"
								]
							}
						}
					}
				},
				"responses": {
					"204": {
						"description": "Token deleted"
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		},
		"schemas": {
			"PluginName": {
				"type": "string",
				"enum": [
					"mia-users-management"
				]
			},
			"Error": {
				"type": "object",
				"description": "JSON Error description",
				"properties": {
					"code": {
						"type": "string"
					},
					"message": {
						"type": "string"
					}
				},
				"required": [
					"code",
					"message"
				]
			},
			"User": {
				"type": "object",
				"description": "Public user representation (no password)",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"description": "Immutable username"
					},
					"isAdmin": {
						"type": "boolean"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					}
				},
				"required": [
					"name",
					"isAdmin",
					"createdAt"
				]
			},
			"PushEventPluginInitialized": {
				"$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginInitialized"
			},
			"PushEventPluginReleased": {
				"$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginReleased"
			},
			"PushEventPluginError": {
				"$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginError"
			}
		}
	},
	"servers": [
		{
			"url": "http://localhost:8000/",
			"description": "test server"
		}
	]
}
